# The native image lane (GATE_MODE=img, compose profile `imglane`). Copy to imglane.env (gitignored, chmod 600).
# Only the PUBLIC token key: the lane verifies the same relay tokens as relay.env and holds no secret.
RELAY_TOKEN_PUBLIC_KEY=
PUBLIC_ORIGIN=https://limitless.taps-holdings.org
# Disk cache size in MB (volume imgcache), largest image in bytes, images per minute per member, parallel WebP encodes.
IMG_CACHE_MB=1024
IMG_MAX_BYTES=10485760
IMG_MEMBER_PER_MIN=300
IMG_CONCURRENCY=2
