# The VPS relay gate (GATE_MODE=relay). Copy to relay.env (gitignored, chmod 600).
# Make the key pair and the shared secret once:  node scripts/relay-keys.ts   (in the limitless-gate checkout)
# The matching PRIVATE half goes to the home gate's deploy/gate.env (Browser repo), never here.
PUBLIC_ORIGIN=https://limitless.taps-holdings.org
RELAY_HOME_URL=https://limitless.taps-holdings.org
RELAY_TOKEN_PUBLIC_KEY=
RELAY_SYNC_SECRET=
# Total uplink in Mbit/s that fair share divides. Measured 2026-11-15: this VPS carries ~490 Mbit/s through the gate for one
# member and ~500 in total, so 150 is a cautious placeholder (the transfer budget is what really limits), replace with Boss's number.
TOTAL_UPLINK_MBPS=150
FAIR_SHARE=on
# Cap for any single member WebSocket in Mbit/s (default 50, 0 = off) so one download cannot take the whole VPS.
RELAY_SOCKET_MAX_MBPS=50
# Kill switches (all default on): download class (lbk.dl sockets), video speed cap, per-plan site totals.
DL_CLASS=on
VIDEO_CAP=on
SITE_STATS=on
