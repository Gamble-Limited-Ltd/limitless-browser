{
  "name": "limitless-browser",
  "version": "1.2.12",
  "private": true,
  "description": "Limitless Browser, a private browsing proxy by Gamble Limited Ltd.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "playwright test",
    "test:legal": "tests/legal-v2/run.sh",
    "test:stack": "deploy/rehearsal/run.sh",
    "test:sites": "LB_SITES=1 deploy/rehearsal/run.sh --project=chromebook --workers=1 tests/stack/sites.spec.js; node scripts/sites-merge.mjs",
    "test:sites:smoke": "LB_SITES=1 LB_SITES_SMOKE=1 deploy/rehearsal/run.sh --project=chromebook --workers=1 tests/stack/sites.spec.js; node scripts/sites-merge.mjs",
    "test:speed:quick": "LB_SPEED=1 LB_SPEED_REPS=3 LB_SPEED_PUBLIC=0 deploy/rehearsal/run.sh --project=chromebook tests/stack/speed.spec.js",
    "test:speed": "LB_SPEED=1 deploy/rehearsal/run.sh tests/stack/speed.spec.js",
    "speed:compare": "node scripts/speed-compare.mjs",
    "test:visual": "playwright test -c playwright.visual.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
